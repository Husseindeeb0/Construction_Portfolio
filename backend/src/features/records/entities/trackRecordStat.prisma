model TrackRecordStat {
  id                    Int                @id @default(autoincrement())
  title                 String
  value                 String
  icon                  String
  displayOrder          Int
  isActive              Boolean            @default(true)
  trackRecordSectionId  Int
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  trackRecordSection TrackRecordSection @relation(fields: [trackRecordSectionId], references: [id], onDelete: Cascade)
}
