model Service {
  id               Int            @id @default(autoincrement())
  title            String
  description      String
  icon             String
  displayOrder     Int
  isActive         Boolean        @default(true)
  serviceSectionId Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceSection ServiceSection @relation(fields: [serviceSectionId], references: [id], onDelete: Cascade)
}
